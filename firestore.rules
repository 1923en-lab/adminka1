rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Замените UID на свои (те же, что в config.js)
    function isOwner() { return request.auth != null && request.auth.uid == 'UID_ВЛАДЕЛЬЦА'; }
    function isAdmin() { return request.auth != null && request.auth.uid == 'UID_АДМИНИСТРАТОРА'; }

    match /people/{id} {
      allow read: if isOwner() || isAdmin();
      allow write: if isOwner();
    }
    match /tasks/{id} {
      allow read: if isOwner() || isAdmin();
      allow create, delete: if isOwner();
      allow update: if isOwner() || (isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
        && request.resource.data.status in ['open', 'review']);
    }
    match /log/{id} {
      allow read: if isOwner() || isAdmin();
      allow write: if isAdmin();   // данные по врачам вносит только администратор
    }
  }
}
